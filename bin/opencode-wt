#!/usr/bin/env bash
set -euo pipefail

# Usage: <self> <new-branch-name>
name="${1:?usage: $(basename "$0") <new-branch-name>}"

root="$(git rev-parse --show-toplevel)"
project="$(basename "$root")"
dir="$HOME/pjs/worktrees/$project/$name"

git worktree add -b "$name" "$dir"

# copy gitignored .env files to new path
rsync -a --prune-empty-dirs \
  --include='*/' \
  --exclude='.git/' \
  --exclude='node_modules/' \
  --exclude='.env.example' \
  --include='.env' \
  --include='.env.*' \
  --exclude='*' \
  "$root"/ "$dir"/

cd "$dir"

if [[ -f package.json ]]; then
  if [[ -f pnpm-lock.yaml ]]; then
    pnpm install
  elif [[ -f yarn.lock ]]; then
    yarn install
  elif [[ -f bun.lock || -f bun.lockb ]]; then
    bun install
  else
    npm install
  fi
fi

printf '%s\n' "$dir"

# command to run in the new Ghostty tab
cmd="opencode"

# open a new Ghostty tab running the command in the worktree
osascript - "$dir" "$cmd" <<'EOF'
on run argv
  set dirPath to item 1 of argv
  set input to (item 2 of argv) & return
  tell application "Ghostty"
    activate
    set cfg to new surface configuration from {initial working directory:dirPath, initial input:input}
    if (count of windows) > 0 then
      set newTab to new tab in front window with configuration cfg
      select tab newTab
    else
      new window with configuration cfg
    end if
  end tell
end run
EOF
