#!/usr/bin/env bash
set -euo pipefail

dir="$("$(dirname "$0")/new-wt" "$@")"

printf '%s\n' "$dir"

# command to run in the new Ghostty tab
cmd="opencode"

# open a new Ghostty tab running the command in the worktree
osascript - "$dir" "$cmd" <<'EOF'
on run argv
  set dirPath to item 1 of argv
  set input to (item 2 of argv) & return
  tell application "Ghostty"
    activate
    set cfg to new surface configuration from {initial working directory:dirPath, initial input:input}
    if (count of windows) > 0 then
      set newTab to new tab in front window with configuration cfg
      select tab newTab
    else
      new window with configuration cfg
    end if
  end tell
end run
EOF
