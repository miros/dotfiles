{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "cliproxyapi": {
      "name": "CLIProxyAPI (Claude)",
      "package": "@opencode/ai/providers/anthropic-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{file:~/.config/opencode/cliproxyapi.key}"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "limit": {
            "context": 500000,
            "output": 128000
          }
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5"
        }
      }
    }
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=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",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {},
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "agents": {
    "test-quality-auditor": {
      "hidden": true
    }
  },
  "plugin": [
    ["@plannotator/opencode@latest", {
      "workflow": "manual"
    }
  ]
  ],
}
