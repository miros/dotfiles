{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "monokai"
  },
  "keybinds": {
    "model.cycle_favorite": "ctrl+m"
  },
  "diffs": {
    "wrap": "word"
  },
  "tabs": {
    "enabled": true,
    "layout": "vertical",
    "scope": "cwd",
    "indicators": "status"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.7999999999999999,
    "sounds": {
      "default": "/System/Library/Sounds/Hero.aiff",
      "question": "/System/Library/Sounds/Hero.aiff",
      "permission": "/System/Library/Sounds/Hero.aiff",
      "error": "/System/Library/Sounds/Hero.aiff",
      "done": "/System/Library/Sounds/Hero.aiff",
      "subagent_done": "/System/Library/Sounds/Hero.aiff"
    }
  },
  "animations": true,
  "terminal": {
    "copy": "select"
  }
}
